@@ -0,0 +1,40 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import '@/test/setup-dom.js';
+import assert from 'node:assert/strict';
+import { afterEach, test } from 'node:test';
+import { act } from 'react';
+import { cleanup, click, render } from '@/test/render';
+import { editedRegistryModel } from '@/test/registry-model-fixture';
+import { registerEnglish } from '@/i18n';
+import { registryEn } from '@/i18n/catalogues/registry.en';
+import { useHandoffWorkspace } from '@/lib/registry/handoff-workspace';
+import { resourceSession } from '@/lib/registry/handoff-auth';
+import { startServer, closeAll } from '../../../../../packages/oci/test/fake-registry.js';
+import { pushRegistry } from '../../../../../packages/oci/test/push-registry.js';
+import { OciPushTo } from './OciPushTo';
+registerEnglish(registryEn);
+afterEach(async () => { cleanup(); useHandoffWorkspace.setState({ handoff:undefined, sourceSession:undefined, destinationSession:undefined, saved:undefined, loadedModelId:undefined }); await closeAll(); });
+async function waitFor(predicate: () => boolean) { for (let i=0;i<100;i++) { if (predicate()) return; await act(async () => { await new Promise(r => setTimeout(r,10)); }); } assert(predicate(),'operation should complete'); }
+
+test('Push to publishes a real edited model without any preceding launch and returns a pinned reopen link', async () => {
+  const model=await editedRegistryModel(), fixture=pushRegistry({repository:'project/model',accept:a => a==='Bearer destination-only'}), server=await startServer((req,res) => { res.setHeader('Access-Control-Allow-Origin',window.location.origin); res.setHeader('Access-Control-Allow-Headers','authorization,content-type'); res.setHeader('Access-Control-Allow-Methods','GET,HEAD,POST,PUT,OPTIONS'); res.setHeader('Access-Control-Expose-Headers','Location,Docker-Content-Digest'); if (req.method==='OPTIONS') { res.writeHead(204); res.end(); return; } return fixture.handler(req,res); });
+  const scope='repository:project/model:pull repository:project/model:push';
+  useHandoffWorkspace.setState({destinationSession:resourceSession({access_token:'destination-only',token_type:'Bearer',expires_in:300,scope},server.origin,scope)});
+  const ui=render(<OciPushTo connections={[{registry:server.origin,authorization_server:'https://identity.example.test',client_id:'ifc-lite'}]} onBusyChange={() => {}} />);
+  const button=Array.from(ui.querySelectorAll('button')).find(b => b.textContent==='Push to…');assert(button);click(button);
+  await waitFor(() => Boolean(useHandoffWorkspace.getState().saved));
+  const saved=useHandoffWorkspace.getState().saved!;
+  assert.equal(saved.registry,server.origin);
+  const manifest=fixture.store.manifests.get(saved.digest);assert(manifest);
+  const descriptor=JSON.parse(new TextDecoder().decode(manifest.bytes)).layers[0];
+  const bytes=fixture.store.blobs.get(descriptor.digest);assert(bytes);
+  const reopened=await model.parser.parseColumnar(new Uint8Array(bytes).buffer,{disableWorkerScan:true});
+  assert.equal(reopened.entities.getName(model.wall),'Registry persisted wall');
+  const link=ui.querySelector('a');assert(link);
+  const encoded=new URL(link.href).hash.slice('#handoff='.length);
+  assert.deepEqual(JSON.parse(Buffer.from(encoded,'base64url').toString()).source,saved);
+  assert(server.requests.filter(r => r.authorization).every(r => r.authorization==='Bearer destination-only'));
+});
diff --git a/apps/viewer/src/components/sources/OciPushTo.tsx b/apps/viewer/src/components/sources/OciPushTo.tsx
new file mode 100644
index 000000000..763fc5d40
--- /dev/null
+++ b/apps/viewer/src/components/sources/OciPushTo.tsx
@@ -0,0 +1,72 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import { useEffect, useId, useRef, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Label } from '@/components/ui/label';
+import { useTranslation } from '@/i18n';
+import { useViewerStore } from '@/store';
+import { exportRegistryModel } from '@/lib/registry/export-model';
+import { authorizeDestination, resourceAllows } from '@/lib/registry/handoff-auth';
+import { pushHandoff } from '@/lib/registry/handoff-client';
+import { connectionFor, HANDOFF_PATH, HANDOFF_PROTOCOL, registryConnections, type RegistryConnection } from '@/lib/registry/handoff-contract';
+import { useHandoffWorkspace } from '@/lib/registry/handoff-workspace';
+
+/** Publishing is available for any active IFC model and obtains destination-specific access. */
+export function OciPushTo({ disabled = false, onBusyChange, connections: configuredConnections }: { disabled?: boolean; onBusyChange: (busy: boolean) => void; connections?: RegistryConnection[] }) {
+  const { t } = useTranslation(); const id = useId();
+  const [connections] = useState(() => configuredConnections ?? registryConnections());
+  const { handoff, saved } = useHandoffWorkspace();
+  const [registry, setRegistry] = useState(handoff?.destination?.registry ?? handoff?.source.registry ?? connections[0].registry);
+  const [repository, setRepository] = useState(handoff?.destination?.repository ?? handoff?.source.repository ?? 'project/model');
+  const [version, setVersion] = useState('revision-2');
+  const [busy, setBusy] = useState(false), [error, setError] = useState('');
+  const pending = useRef<AbortController | null>(null);
+  const model = useViewerStore(state => {
+    const id = state.activeModelId ?? (state.models.size === 1 ? state.models.keys().next().value : undefined);
+    return id ? state.models.get(id) : undefined;
+  });
+  useEffect(() => () => { pending.current?.abort(); }, []);
+  useEffect(() => { onBusyChange(busy); }, [busy, onBusyChange]);
+  function reopenLink(): string {
+    if (!saved) return '#';
+    const context = { protocol: HANDOFF_PROTOCOL, source: saved, intent: 'edit' };
+    const encoded = btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(context)))).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/, '');
+    return `${HANDOFF_PATH}#handoff=${encoded}`;
+  }
+  async function publish() {
+    const controller = new AbortController(); pending.current?.abort(); pending.current = controller;
+    setBusy(true); setError(''); useHandoffWorkspace.setState({ saved: undefined });
+    try {
+      const connection = connectionFor(registry, connections), previous = useHandoffWorkspace.getState().destinationSession;
+      const session = previous?.registry === registry && resourceAllows(previous, repository, 'pull') && resourceAllows(previous, repository, 'push') ? previous
+        : await authorizeDestination(connection, repository, controller.signal);
+      controller.signal.throwIfAborted();
+      useHandoffWorkspace.setState({ destinationSession: session });
+      const source = await exportRegistryModel(); controller.signal.throwIfAborted();
+      const saved = await pushHandoff(registry, repository, version, source.bytes, source.filename, session, controller.signal);
+      // A successful manifest PUT commits publication; the saved version can be opened in a fresh viewer.
+      useHandoffWorkspace.setState({ saved });
+    } catch (failure) { if (!controller.signal.aborted) setError(failure instanceof Error ? failure.message : t('registry.failed')); }
+    finally { if (pending.current === controller) { pending.current = null; setBusy(false); } }
+  }
+  return <div className="grid gap-3">
+    <p className="text-sm">{t('registry.push.explain')}</p>
+    <p className="text-xs text-muted-foreground">{model ? t('registry.activeModel', { name: model.name }) : t('registry.noModel')}</p>
+    <Label htmlFor={`${id}-store`}>{t('registry.push.store')}</Label>
+    <select id={`${id}-store`} className="h-9 w-full rounded-md border bg-background px-3 text-sm" value={registry} disabled={busy || disabled} onChange={e => { setRegistry(e.target.value); useHandoffWorkspace.setState({ saved: undefined }); }}>
+      {connections.map(c => <option key={c.registry} value={c.registry}>{c.name ?? new URL(c.registry).host}</option>)}
+    </select>
+    <Label htmlFor={`${id}-folder`}>{t('registry.push.folder')}</Label>
+    <Input id={`${id}-folder`} value={repository} disabled={busy || disabled} autoComplete="off" onChange={e => { setRepository(e.target.value); useHandoffWorkspace.setState({ saved: undefined }); }} />
+    <Label htmlFor={`${id}-version`}>{t('registry.newVersion')}</Label>
+    <Input id={`${id}-version`} value={version} disabled={busy || disabled} onChange={e => { setVersion(e.target.value); useHandoffWorkspace.setState({ saved: undefined }); }} />
+    <Button disabled={disabled || busy || !model || !repository || !version} onClick={() => void publish()}>{t('registry.push.action')}</Button>
+    {busy && <output className="text-sm">{t('registry.working')}</output>}
+    {error && <p role="alert" className="text-sm text-destructive">{error}</p>}
+    {saved && <><output className="text-sm">{t('registry.push.saved')}</output><a className="text-sm underline" href={reopenLink()} target="_blank" rel="noopener noreferrer">{t('registry.reopen')}</a>
+      <details><summary className="cursor-pointer text-xs">{t('registry.details')}</summary><p className="break-all text-xs">{saved.registry}/{saved.repository}@{saved.digest}</p></details></>}
+  </div>;
+}
diff --git a/apps/viewer/src/components/sources/RegistryLaunchLoader.tsx b/apps/viewer/src/components/sources/RegistryLaunchLoader.tsx
new file mode 100644
index 000000000..c346abcb4
--- /dev/null
+++ b/apps/viewer/src/components/sources/RegistryLaunchLoader.tsx
@@ -0,0 +1,45 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import { useEffect, useRef, useState } from 'react';
+import { useIfcLoader } from '@/hooks/useIfcLoader';
+import { useViewerStore } from '@/store';
+import { sanitizeFilename } from '@/lib/export/download';
+import { pullHandoff } from '@/lib/registry/handoff-client';
+import { RegistryError } from '@/lib/registry/protocol';
+import { useHandoffWorkspace } from '@/lib/registry/handoff-workspace';
+import { Button } from '@/components/ui/button';
+import { useTranslation } from '@/i18n';
+/** Digest-verified IFC data enters the same load path as every other model. */
+export function RegistryLaunchLoader() {
+  const { t } = useTranslation(), { loadFile } = useIfcLoader();
+  const loader = useRef(loadFile); loader.current = loadFile;
+  const [attempt, setAttempt] = useState(0), [busy, setBusy] = useState(true), [error, setError] = useState('');
+  useEffect(() => {
+    const controller = new AbortController(); let disposed = false;
+    queueMicrotask(() => {
+      if (disposed) return;
+      setBusy(true); setError('');
+      void (async () => {
+        const { handoff, sourceSession } = useHandoffWorkspace.getState();
+        if (!handoff || !sourceSession) throw new RegistryError('Open the selected version again to authorize access.');
+        const received = await pullHandoff(handoff.source, sourceSession, controller.signal);
+        controller.signal.throwIfAborted();
+        const modelId = crypto.randomUUID();
+        await loader.current(new File([received.bytes], sanitizeFilename(received.filename, { fallback: 'model.ifc' }), { type: 'application/x-step' }), { kind: 'primary', modelId });
+        controller.signal.throwIfAborted();
+        const state = useViewerStore.getState(), loaded = state.models.get(modelId);
+        if (state.error || loaded?.loadError || loaded?.loadState !== 'complete' || !loaded.ifcDataStore || state.activeModelId !== modelId) throw new RegistryError(loaded?.loadError || state.error || 'The selected model could not be opened.');
+        useHandoffWorkspace.setState({ loadedModelId: modelId });
+        state.setEditEnabled(handoff.intent === 'edit'); state.setSourcesPanelVisible(true);
+      })().catch((failure: unknown) => { if (!disposed) setError(failure instanceof Error ? failure.message : 'Open the selected version again.'); })
+        .finally(() => { if (!disposed) setBusy(false); });
+    });
+    return () => { disposed = true; controller.abort(); };
+  }, [attempt]);
+  if (!busy && !error) return null;
+  return <div className="fixed inset-0 z-50 flex items-center justify-center bg-background/95 p-6"><div className="max-w-md space-y-3 rounded-lg border bg-background p-6">
